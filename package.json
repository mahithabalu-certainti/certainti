{
  "name": "thinkrd365",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:dev": "node api.js && vite --mode dev",
    "start:uat": "node api.js && vite --mode uat",
    "start:preprod": "node api.js && vite --mode preprod",
    "start:prod": "node api.js && vite --mode prod",
    "start:development": "node api.js && vite --mode development",
    "start:qa": "node api.js && vite --mode qa",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:uat": "tsc -b && vite build --mode uat",
    "build:preprod": "tsc -b && vite build --mode preprod",
    "build:prod": "tsc -b && vite build --mode prod",
    "build:development": "tsc -b && vite build --mode development",
    "build:qa": "tsc -b && vite build --mode qa",
    "preview": "vite preview --port 3000",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*\" --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
