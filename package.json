{
  "name": "thinkrd365",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:dev": "vite --mode dev",
    "start:uat": "vite --mode uat",
    "start:preprod": "vite --mode preprod",
    "start:prod": "vite --mode prod",
    "start:development": "vite --mode development",
    "start:qa": "vite --mode qa",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:uat": "tsc -b && vite build --mode uat",
    "build:preprod": "tsc -b && vite build --mode preprod",
    "build:prod": "tsc -b && vite build --mode prod",
    "build:development": "tsc -b && vite build --mode development",
    "build:qa": "tsc -b && vite build --mode qa",
    "preview": "vite preview --port 3000",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*\" --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.4.0",
    "@azure/msal-react": "^3.0.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.5",
    "@mui/x-date-pickers": "^7.28.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.8.3",
    "dayjs": "^1.11.13",
    "i18next": "^24.2.2",
    "libphonenumber-js": "^1.12.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-phone-input-2": "^2.15.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.5",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^4.0.6",
    "vite-plugin-compression": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.5.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
